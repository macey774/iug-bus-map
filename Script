import cairosvg, os

sizes = [72, 96, 128, 144, 152, 192, 384, 512]
os.makedirs('icons', exist_ok=True)

for s in sizes:
    cairosvg.svg2png(
        url='icons/icon.svg',
        write_to=f'icons/icon-{s}.png',
        output_width=s,
        output_height=s
    )
    print(f"✓ icon-{s}.png")

print("Toutes les icônes générées.")
EOF
